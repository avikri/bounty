rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── helpers ─────────────────────────────────────────────────── */

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMember(gid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    function isOwner(gid) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/groups/$(gid)).data.ownerId == request.auth.uid;
    }

    function isAdmin(gid) {
      return isSignedIn() && isMember(gid) &&
        get(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }

    /* ── bounty reward validation ─────────────────────────────────── */
    // A bounty reward is either cash (a bounded integer dollar price, points
    // pinned to that price, no rewardText) or custom (a 1–10 char rewardText,
    // poster-set points 1–1000, no real price). Absent rewardType is treated as
    // cash so pre-feature creates stay valid. points feeds the leaderboard, so
    // it is always validated as a bounded int; price still feeds money/IOUs.

    function isCashReward(d) {
      return !('rewardType' in d) || d.rewardType == 'cash';
    }

    function cashRewardValid(d) {
      return d.price is int
        && d.price >= 1
        && d.price <= 100000
        && !('rewardText' in d)
        // points, if present, must equal the dollar price (preserves 1:1).
        && (!('points' in d) || (d.points is int && d.points == d.price));
    }

    function customRewardValid(d) {
      return d.rewardType == 'custom'
        && d.rewardText is string
        && d.rewardText.size() >= 1
        && d.rewardText.size() <= 10
        && d.points is int
        && d.points >= 1
        && d.points <= 1000
        // No real money on a custom bounty: price absent or explicitly 0.
        && (!('price' in d) || d.price == 0);
    }

    function bountyRewardValid(d) {
      return (isCashReward(d) && cashRewardValid(d)) || customRewardValid(d);
    }

    /* ── users ───────────────────────────────────────────────────── */
    match /users/{userId} {
      // Self-only read: the client only ever reads its own user doc; all
      // other profile data comes from the per-group `members` subcollection
      // (gated by isMember). This blocks full user-base enumeration.
      allow read: if isSelf(userId);
      // totalPoints is a Cloud-Function-maintained aggregate; clients may seed
      // it to 0 on create and may only edit their own profile fields. groupIds
      // is written exclusively by createGroup / joinGroup (Cloud Functions), so
      // it must be created empty. The key allowlist stops a client from seeding
      // server-managed/sensitive fields (e.g. stripeConnectAccountId,
      // stripePayable) that gate where real money is routed.
      allow create: if isSelf(userId)
                     && request.resource.data.totalPoints == 0
                     && request.resource.data.groupIds == []
                     && request.resource.data.keys().hasOnly([
                          'uid', 'displayName', 'handle', 'photoURL',
                          'groupIds', 'totalPoints', 'createdAt']);
      allow update: if isSelf(userId)
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['displayName', 'handle', 'photoURL']);
      allow delete: if false;
    }

    /* ── groups ──────────────────────────────────────────────────── */
    match /groups/{gid} {
      allow read:   if isMember(gid);
      // Group creation goes through the createGroup Cloud Function only, which
      // also provisions the owner's members doc + leaderboard atomically and
      // allocates a unique invite code. A direct client create would otherwise
      // let users spam orphan groups and squat invite codes.
      allow create: if false;
      // Owners/admins may edit display settings only. ownerId, inviteCode,
      // memberCount, etc. are off-limits — otherwise an admin could rewrite
      // ownerId and take over the group.
      allow update: if (isOwner(gid) || isAdmin(gid))
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['name', 'emoji', 'defaultExpiryDays']);
      allow delete: if isOwner(gid);

      /* members subcollection */
      match /members/{userId} {
        allow read: if isMember(gid);
        // Membership is granted only through the joinGroup / createGroup Cloud
        // Functions (which validate the invite code). No client self-create —
        // otherwise any signed-in user could add themselves to any group and
        // read all of its bounties.
        allow create: if false;
        // Owners may change a member's role only. points/wins/losses and the
        // cached profile fields are written exclusively by Cloud Functions, so
        // a member cannot promote themselves or forge their leaderboard score.
        allow update: if isOwner(gid)
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
        // A member can leave; an owner can remove members.
        allow delete: if isOwner(gid) || isSelf(userId);
      }

      /* bounties */
      match /bounties/{bid} {
        allow read:   if isMember(gid);
        // Lock the field set and validate every client-settable value. price
        // feeds points / leaderboard / IOU amounts server-side, so it must be
        // a bounded positive integer — never client-forged, negative, or
        // non-numeric. createdAt must be the server time (blocks feed-pinning
        // via a forged future timestamp); expiresAt must be a timestamp.
        allow create: if isMember(gid)
                       && request.resource.data.keys().hasOnly(
                            ['title', 'description', 'price', 'currency',
                             'rewardType', 'rewardText', 'points',
                             'state', 'posterId', 'claimantId',
                             'expiresAt', 'createdAt'])
                       && request.resource.data.posterId == request.auth.uid
                       && request.resource.data.state == 'available'
                       && request.resource.data.claimantId == null
                       // Reward shape: cash (bounded int price) XOR custom
                       // (rewardText + bounded points). Rejects mixed combos
                       // like custom-with-price or cash-without-price.
                       && bountyRewardValid(request.resource.data)
                       && request.resource.data.title is string
                       && request.resource.data.title.size() > 0
                       && request.resource.data.title.size() <= 80
                       && request.resource.data.description is string
                       && request.resource.data.description.size() <= 1000
                       && request.resource.data.currency is string
                       && request.resource.data.currency.size() <= 8
                       && request.resource.data.expiresAt is timestamp
                       && request.resource.data.createdAt == request.time;
        // State transitions go through Cloud Functions only.
        allow update: if false;
        allow delete: if resource.data.posterId == request.auth.uid
                       && resource.data.state == 'available';

        /* activity timeline — append-only via CF */
        match /activity/{eventId} {
          allow read: if isMember(gid);
          allow write: if false;
        }

        /* pooled contributions — server-write-only, like /ious. Members read
           the contributor list + amounts; the running total is raised only by
           the contributeToBounty callable (admin SDK), never a client write. */
        match /contributions/{contributorId} {
          allow read:  if isMember(gid);
          allow write: if false;
        }

        /* comments — direct client writes, governed strictly (mirrors the
           bounty create allowlist above). Comments are non-load-bearing social
           content, so they take the direct-write path rather than a callable;
           the cost is rules can't rate-limit (acceptable for a friend group).
           authorDisplayName is denormalized at write time. */
        match /comments/{commentId} {
          allow read: if isMember(gid);
          // Lock the field set, pin the author to the caller, bound text length,
          // and force createdAt to the server time (no feed-pinning a comment).
          allow create: if isMember(gid)
                         && request.resource.data.authorUid == request.auth.uid
                         && request.resource.data.keys().hasOnly(
                              ['authorUid', 'authorDisplayName', 'text', 'createdAt'])
                         && request.resource.data.authorDisplayName is string
                         && request.resource.data.authorDisplayName.size() > 0
                         && request.resource.data.authorDisplayName.size() <= 80
                         && request.resource.data.text is string
                         && request.resource.data.text.size() >= 1
                         && request.resource.data.text.size() <= 500
                         && request.resource.data.createdAt == request.time;
          // Author may edit only their own comment, changing just text + the
          // editedAt stamp (which must be the server time).
          allow update: if isSelf(resource.data.authorUid)
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['text', 'editedAt'])
                         && request.resource.data.text is string
                         && request.resource.data.text.size() >= 1
                         && request.resource.data.text.size() <= 500
                         && request.resource.data.editedAt == request.time;
          // Light moderation: the author, the bounty poster, or the group owner.
          allow delete: if isSelf(resource.data.authorUid)
                         || isOwner(gid)
                         || get(/databases/$(database)/documents/groups/$(gid)/bounties/$(bid))
                              .data.posterId == request.auth.uid;
        }
      }

      /* leaderboard summary — CF only */
      match /leaderboard/{docId} {
        allow read:  if isMember(gid);
        allow write: if false;
      }
    }

    /* ── IOUs ────────────────────────────────────────────────────── */
    match /ious/{iouId} {
      // Both parties read the whole doc, including the Stripe fields
      // (paymentMethod, stripePaymentIntentId, stripeStatus, creditorPayable,
      // awaitingCreditorOnboarding) that Cloud Functions denormalize onto it.
      allow read: if isSignedIn()
                   && (resource.data.debtorId == request.auth.uid
                       || resource.data.creditorId == request.auth.uid);
      // Creation/settlement (manual and Stripe-driven) happen via Cloud
      // Functions only. Stripe settlement lives in the signed webhook.
      allow write: if false;
    }

    /* ── notifications ───────────────────────────────────────────── */
    match /notifications/{userId}/inbox/{notifId} {
      allow read, update, delete: if isSelf(userId);
      // Creation by Cloud Functions only.
      allow create: if false;
    }

    /* ── rate-limit counters — Cloud Functions only ──────────────── */
    match /rateLimits/{userId} {
      allow read, write: if false;
    }

    /* ── Stripe webhook idempotency ledger — Cloud Functions only ─── */
    // One doc per processed Stripe event id, so redelivered events are no-ops.
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
